
(Gamma, Delta, Context) |- var := e :: [
    x == var => Gamma'(x) = Gamma(x),
    POS in H[e](Gamma, Delta) => POS addTo Gamma'(x),
    ZERO in H[e](Gamma, Delta) => ZERO addTo Gamma'(x),
    NEG in H[e](Gamma, Delta) => NEG addTo Gamma'(x),
    TRUE in H[e](Gamma, Delta) => TRUE addTo Gamma'(x),
    FALSE in H[e](Gamma, Delta) => FALSE addTo Gamma'(x),
    LOW in H[e](Gamma, Delta) && LOW in Context => LOW addTo Gamma'(x)
];

(Gamma, Delta, Context) |- s1;s2 :: [
 => Delta' = DD[s2](DH[s1](Gamma, Delta, Context), DD[s1](Gamma, Delta, Context), Context),
 => Gamma' = DH[s2](DH[s1](Gamma, Delta, Context), DD[s1](Gamma, Delta, Context), Context)
];

(Gamma, Delta, Context) |- if b then s1 else s2 end :: [
    TRUE  in H[b](Gamma,Delta)  => Gamma' = DH[s1](Gamma, Delta, Context) && Delta' = DD[s1](Gamma, Delta, Context), 
    FALSE in H[b](Gamma, Delta) => Gamma' = DH[s2](Gamma, Delta, Context) && Delta' = DD[s2](Gamma, Delta, Context),
    !(TRUE in H[b](Gamma, Delta)) && !(FALSE in H[b](Gamma,Delta)) && POS in DH[s1](Gamma, Delta, (Context \ LOW))(x) && POS in DH[s2](Gamma, Delta, (Context \ LOW))(x) => POS addTo Gamma'(x),
    !(TRUE in H[b](Gamma, Delta)) && !(FALSE in H[b](Gamma,Delta)) && NEG in DH[s1](Gamma, Delta, (Context \ LOW))(x) && NEG in DH[s2](Gamma, Delta,   (Context \ LOW))(x) => NEG addTo Gamma'(x),
    !(TRUE in H[b](Gamma, Delta)) && !(FALSE in H[b](Gamma,Delta)) && ZERO in DH[s1](Gamma, Delta, (Context \ LOW))(x) && ZERO in DH[s2](Gamma, Delta,  (Context \ LOW))(x) => ZERO addTo Gamma'(x),
    !(TRUE in H[b](Gamma, Delta)) && !(FALSE in H[b](Gamma,Delta)) && TRUE in DH[s1](Gamma, Delta, (Context \ LOW))(x) && TRUE in DH[s2](Gamma, Delta,  (Context \ LOW))(x) => TRUE addTo Gamma'(x),
    !(TRUE in H[b](Gamma, Delta)) && !(FALSE in H[b](Gamma,Delta)) && FALSE in DH[s1](Gamma, Delta, (Context \ LOW))(x) && FALSE in DH[s2](Gamma, Delta, (Context \ LOW))(x) => FALSE addTo Gamma'(x)

]