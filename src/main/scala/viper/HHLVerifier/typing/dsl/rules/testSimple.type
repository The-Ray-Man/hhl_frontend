
/* BASIC OPERATIONS */

exp : LOW[x] <=> forall <_s1>, <_s2> :: _s1[exp] == _s2[exp] && _s1[x] == 0


(Gamma, Delta) |- n :: [
   n == 0 => ZERO addTo H,
   n > 0 => POS addTo H,
   n < 0 => NEG addTo H
];

(Gamma, Delta) |- var ::  [
    => Gamma(var) = H
];

(Gamma, Delta) |- b :: [
   b => TRUE addTo H,
   !(b) => FALSE addTo H
];

/* ARITHMETIC OPERATIONS */
(Gamma, Delta) |- e1 + e2 :: [
    ZERO in H[e1](Gamma, Delta) && ZERO in H[e2](Gamma, Delta) => ZERO addTo H,
    POS  in H[e1](Gamma, Delta) && POS  in H[e2](Gamma, Delta) => POS  addTo H,
    POS  in H[e1](Gamma, Delta) && ZERO in H[e2](Gamma, Delta) => POS  addTo H,
    POS  in H[e2](Gamma, Delta) && POS  in H[e1](Gamma, Delta) => POS  addTo H,
    POS  in H[e2](Gamma, Delta) && ZERO in H[e1](Gamma, Delta) => POS  addTo H,
    NEG  in H[e1](Gamma, Delta) && NEG  in H[e2](Gamma, Delta) => NEG  addTo H,
    NEG  in H[e1](Gamma, Delta) && ZERO in H[e2](Gamma, Delta) => NEG  addTo H,
    NEG  in H[e2](Gamma, Delta) && NEG  in H[e1](Gamma, Delta) => NEG  addTo H,
    NEG  in H[e2](Gamma, Delta) && ZERO in H[e1](Gamma, Delta) => NEG  addTo H
];

(Gamma, Delta) |- e1 % e2 :: [];

(Gamma, Delta) |- e1 * e2 :: [
    ZERO in H[e2](Gamma, Delta) => ZERO addTo H,
    ZERO in H[e1](Gamma, Delta) => ZERO addTo H,
    POS in H[e1](Gamma, Delta) && POS in H[e2](Gamma, Delta) => POS addTo H,
    NEG in H[e1](Gamma, Delta) && NEG in H[e2](Gamma, Delta) => POS addTo H,
    POS in H[e1](Gamma, Delta) && NEG in H[e2](Gamma, Delta) => NEG addTo H,
    NEG in H[e1](Gamma, Delta) && POS in H[e2](Gamma, Delta) => NEG addTo H
];

(Gamma, Delta) |- e1 / e2 :: [
    POS in H[e1](Gamma,Delta) && POS in H[e2](Gamma, Delta) => POS addTo H,
    NEG in H[e1](Gamma,Delta) && NEG in H[e2](Gamma, Delta) => POS addTo H,
    POS in H[e1](Gamma,Delta) && NEG in H[e2](Gamma, Delta) => NEG addTo H,
    NEG in H[e1](Gamma,Delta) && POS in H[e2](Gamma, Delta) => NEG addTo H
];


/* Statements */

|s1;s2|(Gamma, Delta C) = [
    => Gamma' = Gamma[s2](C, Gamma[s1](Gamma, Delta,C), Delta)
]

|x := e|(Gamma, Delta, C) = [
    POS in H[e](Gamma, Delta) => POS addTo Gamma(x),
    NEG in H[e](Gamma, Delta) => NEG addTo Gamma(x),
    ZERO in H[e](Gamma, Delta) => ZERO addTo Gamma(x)
    LOW in H[e](Gamma, Delta) && LOW in C => LOW addTo Gamma(x)
    LOW in D[e](Gamma, Delta)(b) => (b -> LOW) addTo Delta(x)
]


(Gamma, Delta, C) |- if b then s1 else s2 :: [
    LOW in C && LOW in H[b](Gamma, Delta) => combine(C, Gamma[s1](Gamma, Delta, C),  Gamma[s2](Gamma, Delta,C))
]

