
/* BASIC OPERATIONS */


(Gamma, Delta) |- n :: [];

(Gamma, Delta) |- var :: [
    => ZERO addTo D(var),
    => LOW addTo D(var)
];

(Gamma, Delta) |- b :: [];

/* ARITHMETIC OPERATIONS */
(Gamma, Delta) |- e1 + e2 :: [
    x in Vars[e1]    && !(x in Vars[e2]) && LOW  in D[e1](Gamma, Delta)(x)  && LOW in H[e2](Gamma, Delta)     => LOW addTo D(x),
    !(x in Vars[e1]) && x in Vars[e2]    && LOW  in D[e2](Gamma, Delta)(x)  && LOW in H[e1](Gamma, Delta)     => LOW addTo D(x),
    x in Vars[e1]    && x in Vars[e2]    && LOW  in D[e1](Gamma, Delta)(x)  && LOW in D[e2](Gamma, Delta)(x)  => LOW addTo D(x),
    x in Vars[e1]    && !(x in Vars[e2]) && POS  in D[e1](Gamma, Delta)(x)  && POS in H[e2](Gamma, Delta)     => POS addTo D(x),
    x in Vars[e1]    && !(x in Vars[e2]) && POS  in D[e1](Gamma, Delta)(x)  && ZERO in H[e2](Gamma, Delta)    => POS addTo D(x),
    !(x in Vars[e1]) && x in Vars[e2]    && POS  in H[e1](Gamma, Delta)     && POS in D[e2](Gamma, Delta)(x)  => POS addTo D(x),
    !(x in Vars[e1]) && x in Vars[e2]    && ZERO in H[e1](Gamma, Delta)     && POS in D[e2](Gamma, Delta)(x) => POS addTo D(x),
    x in Vars[e1]    && !(x in Vars[e2]) && NEG  in D[e1](Gamma, Delta)(x)  && NEG in H[e2](Gamma, Delta)     => NEG addTo D(x),
    x in Vars[e1]    && !(x in Vars[e2]) && NEG  in D[e1](Gamma, Delta)(x)  && ZERO in H[e2](Gamma, Delta)    => NEG addTo D(x),
    !(x in Vars[e1]) && x in Vars[e2]    && NEG  in H[e1](Gamma, Delta)     && NEG in D[e2](Gamma, Delta)(x)  => NEG addTo D(x),
    !(x in Vars[e1]) && x in Vars[e2]    && ZERO  in H[e1](Gamma, Delta)    && NEG in D[e2](Gamma, Delta)(x) => NEG addTo D(x),
    x in Vars[e1]    && !(x in Vars[e2]) && ZERO in D[e1](Gamma, Delta)(x)  && POS in H[e2](Gamma, Delta)     => POS addTo D(x),
    x in Vars[e1]    && !(x in Vars[e2]) && ZERO in D[e1](Gamma, Delta)(x)  && ZERO in H[e2](Gamma, Delta)    => ZERO addTo D(x),
    !(x in Vars[e1]) && x in Vars[e2]    && POS  in H[e1](Gamma, Delta)     && ZERO in D[e2](Gamma, Delta)(x) => POS addTo D(x),
    !(x in Vars[e1]) && x in Vars[e2]    && ZERO in H[e1](Gamma, Delta)     && ZERO in D[e2](Gamma, Delta)(x) => ZERO addTo D(x)
];

(Gamma, Delta) |- e1 - e2 :: [
    x in Vars[e1]    && !(x in Vars[e2]) && LOW  in D[e1](Gamma, Delta)(x)  && LOW in H[e2](Gamma, Delta)     => LOW addTo D(x),
    !(x in Vars[e1]) && x in Vars[e2]    && LOW  in D[e2](Gamma, Delta)(x)  && LOW in H[e1](Gamma, Delta)     => LOW addTo D(x),
    x in Vars[e1]    && x in Vars[e2]    && LOW  in D[e1](Gamma, Delta)(x)  && LOW in D[e2](Gamma, Delta)(x)  => LOW addTo D(x),

    x in Vars[e1]    && !(x in Vars[e2]) && POS  in D[e1](Gamma, Delta)(x)  && NEG in H[e2](Gamma, Delta) => POS addTo D(x),
    x in Vars[e1]    && !(x in Vars[e2]) && POS  in D[e1](Gamma, Delta)(x)  && ZERO in H[e2](Gamma, Delta) => POS addTo D(x),

    x in Vars[e1]    && !(x in Vars[e2]) && ZERO in D[e1](Gamma, Delta)(x)  && ZERO in H[e2](Gamma, Delta) => ZERO addTo D(x),
    x in Vars[e1]    && !(x in Vars[e2]) && ZERO in D[e1](Gamma, Delta)(x)  && POS in H[e2](Gamma, Delta) => NEG addTo D(x),
    x in Vars[e1]    && !(x in Vars[e2]) && ZERO in D[e1](Gamma, Delta)(x)  && NEG in H[e2](Gamma, Delta) => POS addTo D(x),

    x in Vars[e1]    && !(x in Vars[e2]) && NEG in D[e1](Gamma, Delta)(x)  && ZERO in H[e2](Gamma, Delta) => NEG addTo D(x),
    x in Vars[e1]    && !(x in Vars[e2]) && NEG in D[e1](Gamma, Delta)(x)  && POS in H[e2](Gamma, Delta) => NEG addTo D(x)
]