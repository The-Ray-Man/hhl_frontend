/* STMT OPERATIONS */

|- init(x) :: [
    => MONOUP[x] addTo Gamma'(x),
    => ZERO addTo Delta'(x)(x),
    => LOW addTo Delta'(x)(x)
];

(Gamma, Delta, Context) |- var := e :: [
    => H[e](Gamma, Delta) = Gamma'(var),
    !(x == var) => Gamma(x) = Gamma'(x),
    !(x == var) && Delta hasKey x => Delta(x) = Delta'(x),
    !(Delta hasKey var) => Delta'(var) = D[e](Gamma, Delta),
    Delta hasKey var && Delta(var) hasKey x  && ZERO in Delta(var)(x) && !(D[e](Gamma, Delta) hasKey x) && D[e](Gamma, Delta) hasKey var && POS in  D[e](Gamma, Delta)(var) => POS  addTo Delta'(var)(x),
    Delta hasKey var && Delta(var) hasKey x  && ZERO in Delta(var)(x) && !(D[e](Gamma, Delta) hasKey x) && D[e](Gamma, Delta) hasKey var && NEG in  D[e](Gamma, Delta)(var) => NEG  addTo Delta'(var)(x),
    Delta hasKey var && Delta(var) hasKey x  && ZERO in Delta(var)(x) && !(D[e](Gamma, Delta) hasKey x) && D[e](Gamma, Delta) hasKey var && ZERO in D[e](Gamma, Delta)(var) => ZERO addTo Delta'(var)(x),
    Delta hasKey var && Delta(var) hasKey x  && POS in Delta(var)(x)  && !(D[e](Gamma, Delta) hasKey x) && D[e](Gamma, Delta) hasKey var && POS in  D[e](Gamma, Delta)(var) => POS  addTo Delta'(var)(x),
    Delta hasKey var && Delta(var) hasKey x  && POS in Delta(var)(x)  && !(D[e](Gamma, Delta) hasKey x) && D[e](Gamma, Delta) hasKey var && ZERO in D[e](Gamma, Delta)(var) => POS  addTo Delta'(var)(x),
    Delta hasKey var && Delta(var) hasKey x  && NEG in Delta(var)(x)  && !(D[e](Gamma, Delta) hasKey x) && D[e](Gamma, Delta) hasKey var && NEG in  D[e](Gamma, Delta)(var) => NEG  addTo Delta'(var)(x),
    Delta hasKey var && Delta(var) hasKey x  && NEG in Delta(var)(x)  && !(D[e](Gamma, Delta) hasKey x) && D[e](Gamma, Delta) hasKey var && ZERO in D[e](Gamma, Delta)(var) => NEG  addTo Delta'(var)(x),
    Delta hasKey var && Delta(var) hasKey x  && ZERO in Delta(var)(x) && D[e](Gamma, Delta) hasKey x    && ZERO in D[e](Gamma, Delta)(x)   => ZERO addTo Delta'(var)(x),
    Delta hasKey var && Delta(var) hasKey x  && ZERO in Delta(var)(x) && D[e](Gamma, Delta) hasKey x    && POS  in D[e](Gamma, Delta)(x)   => POS  addTo Delta'(var)(x),
    Delta hasKey var && Delta(var) hasKey x  && ZERO in Delta(var)(x) && D[e](Gamma, Delta) hasKey x    && NEG  in D[e](Gamma, Delta)(x)   => NEG  addTo Delta'(var)(x),
    Delta hasKey var && Delta(var) hasKey x  && POS  in Delta(var)(x) && D[e](Gamma, Delta) hasKey x    && ZERO in D[e](Gamma, Delta)(x)   => POS  addTo Delta'(var)(x),
    Delta hasKey var && Delta(var) hasKey x  && POS  in Delta(var)(x) && D[e](Gamma, Delta) hasKey x    && POS  in D[e](Gamma, Delta)(x)   => POS  addTo Delta'(var)(x),
    Delta hasKey var && Delta(var) hasKey x  && NEG  in Delta(var)(x) && D[e](Gamma, Delta) hasKey x    && ZERO in D[e](Gamma, Delta)(x)   => NEG  addTo Delta'(var)(x),
    Delta hasKey var && Delta(var) hasKey x  && NEG  in Delta(var)(x) && D[e](Gamma, Delta) hasKey x    && NEG  in D[e](Gamma, Delta)(x)   => NEG  addTo Delta'(var)(x),
    Delta hasKey var && Delta(var) hasKey x  && LOW  in Delta(var)(x) && D[e](Gamma, Delta) hasKey x    && LOW  in D[e](Gamma, Delta)(x)   => LOW  addTo Delta'(var)(x)
];

(Gamma, Delta, Context) |- s1;s2 :: [
    => Gamma' = DH[s2](DH[s1](Gamma, Delta, Context), DD[s1](Gamma, Delta, Context), Context),
    => Delta' = DD[s2](DH[s1](Gamma, Delta, Context), DD[s1](Gamma, Delta, Context), Context)
];

(Gamma, Delta, Context) |- if b then s1 else s2 end :: [
    LOW in H[b](Gamma, Delta) && LOW in DH[s1](Gamma, InitDelta(AllVariables), Context)(x) && LOW in DH[s2](Gamma, InitDelta(AllVariables), Context)(x) => LOW addTo Gamma'(x),
    TRUE in H[b](Gamma, Delta) => Gamma' = DH[s1](Gamma, InitDelta(AllVariables), Context) && Delta' = DD[s1](Gamma, InitDelta(AllVariables), Context),
    FALSE in H[b](Gamma, Delta) => Gamma' = DH[s2](Gamma, InitDelta(AllVariables), Context) && Delta' = DD[s2](Gamma, InitDelta(AllVariables), Context),
    POS in DH[s1](Gamma, InitDelta(AllVariables), Context)(x) && POS in DH[s2](Gamma, InitDelta(AllVariables), Context)(x) => POS addTo Gamma'(x),
    NEG in DH[s1](Gamma, InitDelta(AllVariables), Context)(x) && NEG in DH[s2](Gamma, InitDelta(AllVariables), Context)(x) => NEG addTo Gamma'(x),
    ZERO in DH[s1](Gamma, InitDelta(AllVariables), Context)(x) && ZERO in DH[s2](Gamma, InitDelta(AllVariables), Context)(x) => ZERO addTo Gamma'(x),
    TRUE in DH[s1](Gamma, InitDelta(AllVariables), Context)(x) && TRUE in DH[s2](Gamma, InitDelta(AllVariables), Context)(x) => TRUE addTo Gamma'(x),
    FALSE in DH[s1](Gamma, InitDelta(AllVariables), Context)(x) && FALSE in DH[s2](Gamma, InitDelta(AllVariables), Context)(x) => FALSE addTo Gamma'(x),
    MONOUP[x] in H[b](Gamma, Delta) && LOW in DD[s1](Gamma, InitDelta(AllVariables), Context)(y)(y) && POS in DD[s1](Gamma, InitDelta(AllVariables), Context)(y)(y)  && LOW in DD[s2](Gamma, InitDelta(AllVariables), Context)(y)(y) && NEG in DD[s2](Gamma, InitDelta(AllVariables), Context)(y)(y)  => MONOUP[x] addTo Gamma'(y),
    MONOUP[x] in H[b](Gamma, Delta) && !(x in Assigned[s1]) && LOW in DD[s1](Gamma, InitDelta(AllVariables), Context)(y)(y) && NEG in DD[s2](Gamma, InitDelta(AllVariables), Context)(y)(y)  => MONOUP[x] addTo Gamma'(y),
    MONOUP[x] in H[b](Gamma, Delta) && LOW in DD[s1](Gamma, InitDelta(AllVariables), Context)(y)(y) && POS in DD[s1](Gamma, InitDelta(AllVariables), Context)(y)(y)  && !(x in Assigned[s2]) => MONOUP[x] addTo Gamma'(y),

    !(x in Assigned[s1]) && !(x in Assigned[s2]) => Gamma'(x) = Gamma(x),
    !(x in Assigned[s1]) && !(x in Assigned[s2]) && Delta hasKey x => Delta'(x) = Delta(x)
];

(Gamma, Delta, Context) |- havoc(x) :: []