/* STMT OPERATIONS */

|- methodInit(x) :: [
    x in AllParameters => MONOUP[x] addTo Gamma'(x),
    x in AllParameters => ZERO addTo Delta'(x)(x),
    x in AllParameters => LOW addTo Delta'(x)(x),
    !(x in AllParameters) => NULL addTo Gamma'(x)
];

(Gamma, Delta) |- init :: [
    => Gamma'(x) = Gamma(x),
    => ZERO addTo Delta'(x)(x),
    => LOW addTo Delta'(x)(x)
];

(Gamma, Delta) |- var := e :: [
    => H[e](Gamma, Delta) = Gamma'(var),
    !(x == var) => Gamma(x) addTo Gamma'(x),
    !(x == var) && Delta hasKey x => Delta(x) = Delta'(x),
    NULL in Gamma(var) => ZERO addTo Delta'(var)(var) && LOW addTo Delta'(var)(var),
    Delta hasKey var && Delta(var) hasKey x  && ZERO in Delta(var)(x) && !(D[e](Gamma, Delta) hasKey x) && D[e](Gamma, Delta) hasKey var && POS in  D[e](Gamma, Delta)(var) => POS  addTo Delta'(var)(x),
    Delta hasKey var && Delta(var) hasKey x  && ZERO in Delta(var)(x) && !(D[e](Gamma, Delta) hasKey x) && D[e](Gamma, Delta) hasKey var && NEG in  D[e](Gamma, Delta)(var) => NEG  addTo Delta'(var)(x),
    Delta hasKey var && Delta(var) hasKey x  && ZERO in Delta(var)(x) && !(D[e](Gamma, Delta) hasKey x) && D[e](Gamma, Delta) hasKey var && ZERO in D[e](Gamma, Delta)(var) => ZERO addTo Delta'(var)(x),
    Delta hasKey var && Delta(var) hasKey x  && POS in Delta(var)(x)  && !(D[e](Gamma, Delta) hasKey x) && D[e](Gamma, Delta) hasKey var && POS in  D[e](Gamma, Delta)(var) => POS  addTo Delta'(var)(x),
    Delta hasKey var && Delta(var) hasKey x  && POS in Delta(var)(x)  && !(D[e](Gamma, Delta) hasKey x) && D[e](Gamma, Delta) hasKey var && ZERO in D[e](Gamma, Delta)(var) => POS  addTo Delta'(var)(x),
    Delta hasKey var && Delta(var) hasKey x  && NEG in Delta(var)(x)  && !(D[e](Gamma, Delta) hasKey x) && D[e](Gamma, Delta) hasKey var && NEG in  D[e](Gamma, Delta)(var) => NEG  addTo Delta'(var)(x),
    Delta hasKey var && Delta(var) hasKey x  && NEG in Delta(var)(x)  && !(D[e](Gamma, Delta) hasKey x) && D[e](Gamma, Delta) hasKey var && ZERO in D[e](Gamma, Delta)(var) => NEG  addTo Delta'(var)(x),
    Delta hasKey var && Delta(var) hasKey x  && ZERO in Delta(var)(x) && D[e](Gamma, Delta) hasKey x    && ZERO in D[e](Gamma, Delta)(x)   => ZERO addTo Delta'(var)(x),
    Delta hasKey var && Delta(var) hasKey x  && ZERO in Delta(var)(x) && D[e](Gamma, Delta) hasKey x    && POS  in D[e](Gamma, Delta)(x)   => POS  addTo Delta'(var)(x),
    Delta hasKey var && Delta(var) hasKey x  && ZERO in Delta(var)(x) && D[e](Gamma, Delta) hasKey x    && NEG  in D[e](Gamma, Delta)(x)   => NEG  addTo Delta'(var)(x),
    Delta hasKey var && Delta(var) hasKey x  && POS  in Delta(var)(x) && D[e](Gamma, Delta) hasKey x    && ZERO in D[e](Gamma, Delta)(x)   => POS  addTo Delta'(var)(x),
    Delta hasKey var && Delta(var) hasKey x  && POS  in Delta(var)(x) && D[e](Gamma, Delta) hasKey x    && POS  in D[e](Gamma, Delta)(x)   => POS  addTo Delta'(var)(x),
    Delta hasKey var && Delta(var) hasKey x  && NEG  in Delta(var)(x) && D[e](Gamma, Delta) hasKey x    && ZERO in D[e](Gamma, Delta)(x)   => NEG  addTo Delta'(var)(x),
    Delta hasKey var && Delta(var) hasKey x  && NEG  in Delta(var)(x) && D[e](Gamma, Delta) hasKey x    && NEG  in D[e](Gamma, Delta)(x)   => NEG  addTo Delta'(var)(x),
    Delta hasKey var && Delta(var) hasKey x  && LOW  in Delta(var)(x) && D[e](Gamma, Delta) hasKey x    && LOW  in D[e](Gamma, Delta)(x)   => LOW  addTo Delta'(var)(x)
];

(Gamma, Delta) |- s1;s2 :: [
    => Gamma' = DH[s2](DH[s1](Gamma, Delta), DD[s1](Gamma, Delta)),
    => Delta' = DD[s2](DH[s1](Gamma, Delta), DD[s1](Gamma, Delta))
];

(Gamma, Delta) |- if b then s1 else s2 end :: [
    LOW in H[b](Gamma, Delta) && LOW in DH[s1](Gamma, InitDelta)(x) && LOW in DH[s2](Gamma, InitDelta)(x) => LOW addTo Gamma'(x),
    LOW in H[b](Gamma, Delta) && MONOUP[y] in DH[s1](Gamma, InitDelta)(x) && MONOUP[y] in DH[s2](Gamma, InitDelta)(x) => MONOUP[y] addTo Gamma'(x),
    LOW in H[b](Gamma, Delta) && MONODOWN[y] in DH[s1](Gamma, InitDelta)(x) && MONODOWN[y] in DH[s2](Gamma, InitDelta)(x) => MONODOWN[y] addTo Gamma'(x),


    TRUE in H[b](Gamma, Delta) => Gamma' = DH[s1](Gamma, InitDelta) && Delta' = DD[s1](Gamma, InitDelta),
    FALSE in H[b](Gamma, Delta) => Gamma' = DH[s2](Gamma, InitDelta) && Delta' = DD[s2](Gamma, InitDelta),
    POS in DH[s1](Gamma, InitDelta)(x) && POS in DH[s2](Gamma, InitDelta)(x) => POS addTo Gamma'(x),
    NEG in DH[s1](Gamma, InitDelta)(x) && NEG in DH[s2](Gamma, InitDelta)(x) => NEG addTo Gamma'(x),
    ZERO in DH[s1](Gamma, InitDelta)(x) && ZERO in DH[s2](Gamma, InitDelta)(x) => ZERO addTo Gamma'(x),
    TRUE in DH[s1](Gamma, InitDelta)(x) && TRUE in DH[s2](Gamma, InitDelta)(x) => TRUE addTo Gamma'(x),
    FALSE in DH[s1](Gamma, InitDelta)(x) && FALSE in DH[s2](Gamma, InitDelta)(x) => FALSE addTo Gamma'(x),
    MONOUP[x] in H[b](Gamma, Delta) && LOW in DD[s1](Gamma, InitDelta)(y)(y) && POS in DD[s1](Gamma, InitDelta)(y)(y)  && LOW in DD[s2](Gamma, InitDelta)(y)(y) && NEG in DD[s2](Gamma, InitDelta)(y)(y)  => MONOUP[x] addTo Gamma'(y),
    MONOUP[x] in H[b](Gamma, Delta) && !(x in Assigned[s1]) && LOW in DD[s2](Gamma, InitDelta)(y)(y) && NEG in DD[s2](Gamma, InitDelta)(y)(y)  => MONOUP[x] addTo Gamma'(y),
    MONOUP[x] in H[b](Gamma, Delta) && LOW in DD[s1](Gamma, InitDelta)(y)(y) && POS in DD[s1](Gamma, InitDelta)(y)(y)  && !(x in Assigned[s2]) => MONOUP[x] addTo Gamma'(y),
    
    MONOUP[x] in H[b](Gamma, Delta) && LOW in DD[s1](Gamma, InitDelta)(y)(y) && NEG in DD[s1](Gamma, InitDelta)(y)(y)  && LOW in DD[s2](Gamma, InitDelta)(y)(y) && POS in DD[s2](Gamma, InitDelta)(y)(y)  => MONODOWN[x] addTo Gamma'(y),
    MONOUP[x] in H[b](Gamma, Delta) && !(x in Assigned[s1]) && LOW in DD[s2](Gamma, InitDelta)(y)(y) && POS in DD[s2](Gamma, InitDelta)(y)(y)  => MONODOWN[x] addTo Gamma'(y),
    MONOUP[x] in H[b](Gamma, Delta) && LOW in DD[s1](Gamma, InitDelta)(y)(y) && NEG in DD[s1](Gamma, InitDelta)(y)(y)  && !(x in Assigned[s2]) => MONODOWN[x] addTo Gamma'(y),

    MONODOWN[x] in H[b](Gamma, Delta) && LOW in DD[s1](Gamma, InitDelta)(y)(y) && POS in DD[s1](Gamma, InitDelta)(y)(y)  && LOW in DD[s2](Gamma, InitDelta)(y)(y) && NEG in DD[s2](Gamma, InitDelta)(y)(y)  => MONODOWN[x] addTo Gamma'(y),
    MONODOWN[x] in H[b](Gamma, Delta) && !(x in Assigned[s1]) && LOW in DD[s2](Gamma, InitDelta)(y)(y) && NEG in DD[s2](Gamma, InitDelta)(y)(y)  => MONODOWN[x] addTo Gamma'(y),
    MONODOWN[x] in H[b](Gamma, Delta) && LOW in DD[s1](Gamma, InitDelta)(y)(y) && POS in DD[s1](Gamma, InitDelta)(y)(y)  && !(x in Assigned[s2]) => MONODOWN[x] addTo Gamma'(y),
    
    MONODOWN[x] in H[b](Gamma, Delta) && LOW in DD[s1](Gamma, InitDelta)(y)(y) && NEG in DD[s1](Gamma, InitDelta)(y)(y)  && LOW in DD[s2](Gamma, InitDelta)(y)(y) && POS in DD[s2](Gamma, InitDelta)(y)(y)  => MONOUP[x] addTo Gamma'(y),
    MONODOWN[x] in H[b](Gamma, Delta) && !(x in Assigned[s1]) && LOW in DD[s2](Gamma, InitDelta)(y)(y) && POS in DD[s2](Gamma, InitDelta)(y)(y)  => MONOUP[x] addTo Gamma'(y),
    MONODOWN[x] in H[b](Gamma, Delta) && LOW in DD[s1](Gamma, InitDelta)(y)(y) && NEG in DD[s1](Gamma, InitDelta)(y)(y)  && !(x in Assigned[s2]) => MONOUP[x] addTo Gamma'(y),

    !(x in Assigned[s1]) && !(x in Assigned[s2]) => Gamma'(x) = Gamma(x),
    !(x in Assigned[s1]) && !(x in Assigned[s2]) && Delta hasKey x => Delta'(x) = Delta(x),

    LOW in H[b](Gamma, Delta) && LOW  in DD[s1](Gamma, InitDelta)(x)(y) && LOW  in DD[s2](Gamma, InitDelta)(x)(y) => LOW addTo Delta'(x)(y),
    LOW in H[b](Gamma, Delta) && POS  in DD[s1](Gamma, InitDelta)(x)(y) && POS  in DD[s2](Gamma, InitDelta)(x)(y) => POS addTo Delta'(x)(y),
    LOW in H[b](Gamma, Delta) && ZERO in DD[s1](Gamma, InitDelta)(x)(y) && ZERO in DD[s2](Gamma, InitDelta)(x)(y) => ZERO addTo Delta'(x)(y),
    LOW in H[b](Gamma, Delta) && NEG  in DD[s1](Gamma, InitDelta)(x)(y) && NEG  in DD[s2](Gamma, InitDelta)(x)(y) => NEG addTo Delta'(x)(y)
];

(Gamma, Delta) |- havoc x :: [
    !(y == x) => Gamma'(y) = Gamma(y) && Delta'(y) = Delta(y)
]