/* STMT OPERATIONS */

|- init(x) :: [
    => MONOUP[x] addTo Gamma'(x),
    => ZERO addTo Delta'(x)(x),
    => LOW addTo Delta'(x)(x)
];

(Gamma, Delta, Context) |- var := e :: [
    => H[e](Gamma, Delta) = Gamma'(var),
    !(x == var) => Gamma(x) = Gamma'(x),
    !(x == var) && Delta hasKey x => Delta(x) = Delta'(x),
    !(Delta hasKey var) && D[e](Gamma, Delta) hasKey var => Delta'(var)(var) = D[e](Gamma, Delta)(var),
    Delta hasKey var && !(Delta(var) hasKey var) => Delta'(var)(var) = D[e](Gamma, Delta)(var),
    ZERO in Delta(var)(var) && ZERO in D[e](Gamma, Delta)(var) => ZERO addTo Delta'(var)(var),
    ZERO in Delta(var)(var) && POS in D[e](Gamma, Delta)(var) => POS addTo Delta'(var)(var),
    ZERO in Delta(var)(var) && NEG in D[e](Gamma, Delta)(var) => NEG addTo Delta'(var)(var),
    POS in Delta(var)(var) && ZERO in D[e](Gamma, Delta)(var) => POS addTo Delta'(var)(var),
    POS in Delta(var)(var) && POS in D[e](Gamma, Delta)(var) => POS addTo Delta'(var)(var),
    NEG in Delta(var)(var) && ZERO in D[e](Gamma, Delta)(var) => NEG addTo Delta'(var)(var),
    NEG in Delta(var)(var) && NEG in D[e](Gamma, Delta)(var) => NEG addTo Delta'(var)(var),
    LOW in Delta(var)(var) && LOW in D[e](Gamma, Delta)(var) => LOW addTo Delta'(var)(var)
];

(Gamma, Delta, Context) |- s1;s2 :: [
    => Gamma' = DH[s2](DH[s1](Gamma, Delta, Context), DD[s1](Gamma, Delta, Context), Context),
    => Delta' = DD[s2](DH[s1](Gamma, Delta, Context), DD[s1](Gamma, Delta, Context), Context)
];

(Gamma, Delta, Context) |- if b then s1 else s2 end :: [
    LOW in H[b](Gamma, Delta) && LOW in DH[s1](Gamma, Delta, Context)(x) && LOW in DH[s2](Gamma, Delta, Context)(x) => LOW addTo Gamma'(x),
    TRUE in H[b](Gamma, Delta) => Gamma' = DH[s1](Gamma, Delta, Context) && Delta' = DD[s1](Gamma, Delta, Context),
    FALSE in H[b](Gamma, Delta) => Gamma' = DH[s2](Gamma, Delta, Context) && Delta' = DD[s2](Gamma, Delta, Context),
    POS in DH[s1](Gamma, Delta, Context)(x) && POS in DH[s2](Gamma, Delta, Context)(x) => POS addTo Gamma'(x),
    NEG in DH[s1](Gamma, Delta, Context)(x) && NEG in DH[s2](Gamma, Delta, Context)(x) => NEG addTo Gamma'(x),
    ZERO in DH[s1](Gamma, Delta, Context)(x) && ZERO in DH[s2](Gamma, Delta, Context)(x) => ZERO addTo Gamma'(x),
    TRUE in DH[s1](Gamma, Delta, Context)(x) && TRUE in DH[s2](Gamma, Delta, Context)(x) => TRUE addTo Gamma'(x),
    FALSE in DH[s1](Gamma, Delta, Context)(x) && FALSE in DH[s2](Gamma, Delta, Context)(x) => FALSE addTo Gamma'(x),
    MONOUP[x] in H[b](Gamma, Delta) && LOW in DD[s1](Gamma, Delta, Context)(y)(y) && POS in DD[s1](Gamma, Delta, Context)(y)(y) && LOW in DD[s2](Gamma, Delta, Context)(y)(y) && NEG in DD[s2](Gamma, Delta, Context)(y)(y) => MONOUP[x] addTo Gamma'(y),
    MONOUP[x] in H[b](Gamma, Delta) && ZERO in DD[s1](Gamma, Delta, Context)(y)(y) && NEG in DD[s2](Gamma, Delta, Context)(y)(y) => MONOUP[x] addTo Gamma'(y),
    MONOUP[x] in H[b](Gamma, Delta) && POS in DD[s1](Gamma, Delta, Context)(y)(y) && ZERO in DD[s2](Gamma, Delta, Context)(y)(y) => MONOUP[x] addTo Gamma'(y)
];

(Gamma, Delta, Context) |- havoc(x) :: []