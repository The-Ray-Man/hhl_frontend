

method foo(x : Int[LOW], y : Int) returns (o : Int[LOW]) 
{
    var z : Int
    o := 0
    z := x
    while (z < 10) {
        o := o + 1
        z := z + 1
    }
}

method bar(y: Int[LOW], z:Seq[Int]) returns (o : Int[LOW])
{
    var i : Int
    var e : Int
    var k : Int
    i := 0
    o := 0
    while (i < |z|){
        e := z[i]
        k := foo(y, e)
        o := o + k
    } 
}