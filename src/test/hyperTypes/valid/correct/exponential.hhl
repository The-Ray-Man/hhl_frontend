method exp(x: Int[low,pos, absGtOne], n: Int) returns (r: Int[monoUp[n]])
    // requires forall <_s> :: _s[x] >= 1 && _s[n] >= 0
    // requires forall <_s1>, <_s2> :: _s1[t] == 1 ==> _s2[t] == 2 ==> _s1[x] >= _s2[x]
    // requires forall <_s1>, <_s2> :: _s1[t] == 1 ==> _s2[t] == 2 ==> _s1[n] >= _s2[n]
    // ensures forall <_s1>, <_s2> :: _s1[t] == 1 ==> _s2[t] == 2 ==> _s1[r] >= _s2[r]
{
    r := 1
    var i: Int
    i := 0
    while (i < n)
        // invariant forall <_s1>, <_s2> :: _s1[t] == 1 ==> _s2[t] == 2 ==> _s1[x] >= _s2[x]
        // invariant forall <_s1>, <_s2> :: _s1[t] == 1 ==> _s2[t] == 2 ==> _s1[n] - _s1[i] >= _s2[n] - _s2[i]
        // invariant forall <_s1>, <_s2> :: _s1[t] == 1 ==> _s2[t] == 2 ==> _s1[r] >= _s2[r]
        // invariant forall <_s> :: _s[x] >= 1 && _s[r] >= 1
    {
        r := r * x
        i := i + 1
    }
}