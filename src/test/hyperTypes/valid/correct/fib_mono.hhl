method fib(n : Int) returns (o: Int[monoUp[n]])
{
    var a : Int
    var b : Int
    var i : Int
    var tmp : Int
    a := 0
    b := 1
    i := 0
    while (i < n)
    {
        tmp := b
        b := a + b
        a := tmp
        i := i + 1
    }
    o := b
}

method caller(n: Int, t: Bool) returns (x: Int)
    requires forall <_s1>, <_s2> :: _s1[t] ==> !_s2[t] ==> _s1[n] >= _s2[n]
    ensures forall <_s1>, <_s2> :: _s1[t] ==> !_s2[t] ==> _s1[x] >= _s2[x]
    ensures forall <_s1>, <_s2> :: _s1[t] ==> !_s2[t] ==> _s1[x] <= _s2[x]
{
    x := fib(n)
    unfold (monoUp[n]) x
}