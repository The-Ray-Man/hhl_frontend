method testSafeBranching(s1: Int[LOW], s2: Int) returns (o : Int[LOW])
{
    var s1new : Int
    s1new := s1
    o := 0
    while (s1new > 0){
        
        unfold (LOW) o
        if (s1new > s2) {
            o := o + 1
        } else {
            o := o + 1
        }
        fold (LOW) o
        s1new := s1new - 1
    }
}
