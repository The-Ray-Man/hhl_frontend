method secure(l : Int, h : Int) returns (o : Int) 
  requires forall <_s1>, <_s2> :: (_s1[l] == _s2[l])
  ensures forall <_s1>, <_s2> :: (_s1[o] == _s2[o])
{
  // Start Part 1
  var z : Int
  var x : Int
  z := 1
  x := l
  while (x > z) 
    invariant forall <_s1> , <_s2> :: (_s1[x] + _s1[z] == _s2[x] + _s2[z]) && _s1[x]  == _s2[x]

  {
      x := x - 1
      z := z + 1
  }
  // End Part 1
  // Start Part 2
  o:= 0
  while (x > 0) 
    invariant forall <_s1>, <_s2> :: (_s1[x] + _s1[o] == _s2[x] + _s2[o]) && _s1[x]  ==_s2[x]
  {
      o := o + h
      o := o + 1
      x := x - 1
      o := o - h
  }
  // End Part 2
}